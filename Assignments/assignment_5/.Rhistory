# Define "perfect biking weather" as 60-75°F with no rain
study_panel <- study_panel %>%
mutate(
perfect_weather = ifelse(
!is.na(temperature) &
temperature >= 60 &
temperature <= 75 &
(is.na(precipitation) | precipitation < 0.01),
1, 0
)
)
# Check distribution
cat("Hours with perfect weather:",
sum(study_panel$perfect_weather, na.rm = TRUE), "\n")
cat("Average trips in perfect weather:",
mean(study_panel$trips[study_panel$perfect_weather == 1], na.rm = TRUE), "\n")
cat("Average trips otherwise:",
mean(study_panel$trips[study_panel$perfect_weather == 0], na.rm = TRUE), "\n")
